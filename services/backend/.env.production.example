# ============================================================
# SSR One AI – Enterprise Production Environment Template
# Duplicate this file as `.env` on your production server
# ============================================================

# --- Core Platform Settings ---
APP_NAME="SSR One AI Platform"
APP_VERSION="1.0.0"
APP_ENV="production"
APP_DEBUG="false"
APP_SECRET_KEY="generate-secure-64-character-random-hex-string-for-production"
APP_ALLOWED_HOSTS="ssrone.ai,*.ssrone.ai,localhost,127.0.0.1"
FRONTEND_URL="https://app.ssrone.ai"

# --- Production CORS ---
CORS_ORIGINS="https://ssrone.ai,https://app.ssrone.ai,https://admin.ssrone.ai,https://kitchen.ssrone.ai,https://order.ssrone.ai,https://menu.ssrone.ai,https://stay.ssrone.ai,https://staff.ssrone.ai"
CORS_ORIGIN_REGEX="https?://.*\.ssrone\.ai(:[0-9]+)?"

# --- PostgreSQL Database (Production Pool) ---
DB_HOST="postgres"
DB_PORT=5432
DB_NAME="ssrone_db"
DB_USER="ssrone_admin"
DB_PASSWORD="change-this-to-a-strong-generated-password-in-production"
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=50
DB_ECHO=false

# DSN (automatically constructed or set directly)
DATABASE_URL="postgresql+asyncpg://ssrone_admin:change-this-to-a-strong-generated-password-in-production@postgres:5432/ssrone_db"

# --- Redis (Cache, WebSockets, Rate Limiting) ---
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://redis:6379/0"

# --- JWT Authentication ---
JWT_SECRET_KEY="generate-another-cryptographically-secure-token-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Background Worker (Celery) ---
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# --- File Storage (AWS S3 or Local) ---
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="/app/uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION="ap-south-1"

# --- AI Engines ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
AI_FALLBACK_MODEL="gpt-4o-mini"

# --- Operational Monitoring & Telemetry ---
SENTRY_DSN=""
PROMETHEUS_METRICS_PATH="/metrics"
FEATURE_OFFLINE_POS=true
FEATURE_MULTI_TENANT=true
