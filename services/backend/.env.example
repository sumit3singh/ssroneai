# ============================================================
# The Baithak – Backend Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="The Baithak Hospitality Platform"
APP_VERSION="1.0.0"
APP_ENV="development"           # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
APP_ALLOWED_HOSTS="localhost,127.0.0.1"
FRONTEND_URL="http://localhost:5173"

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafedb
DB_USER=postgres
DB_PASSWORD=asd123
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# Constructed DSN (auto-built from above, or override directly)
# DATABASE_URL=postgresql+asyncpg://postgres:asd123@localhost:5432/cafedb

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Celery ---
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="The Baithak <noreply@baithak.com>"
SMTP_TLS=true

# --- Storage (AWS S3 or MinIO) ---
STORAGE_PROVIDER="local"        # local | s3 | minio
STORAGE_LOCAL_PATH="./uploads"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=baithak-uploads
AWS_S3_REGION=ap-south-1

# --- AI / LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL="claude-sonnet-4-6"
AI_FALLBACK_MODEL="gpt-4o-mini"
AI_MAX_TOKENS_PER_DAY=1000000
AI_COST_LIMIT_USD_PER_DAY=10.0

# --- SMS / WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Payment Gateways ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Monitoring ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PATH=/metrics

# --- Feature Flags ---
FEATURE_AI_COPILOT=true
FEATURE_OFFLINE_POS=true
FEATURE_MULTI_TENANT=true
FEATURE_WHATSAPP=false
